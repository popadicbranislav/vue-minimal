{
  "name": "vue-minimal",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "analyze": "pnpm dlx vite-bundle-analyzer -m static -o false -d brotli"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@unhead/vue": "2.0.0-alpha.16",
    "@vueuse/core": "^12.6.1",
    "tailwindcss": "^4.0.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.1",
    "@iconify/vue": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.20.1",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.50.1",
    "pnpm": "^10.4.0",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.1.0",
    "vite": "^6.1.0",
    "vite-plugin-pages": "^0.32.4",
    "vitest": "^3.0.5",
    "vitest-browser-vue": "^0.2.0",
    "vue-tsc": "^2.2.0"
  }
}
